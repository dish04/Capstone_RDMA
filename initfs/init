#!/bin/busybox sh

# Export initial standard search PATH
export PATH=/bin:/usr/bin:/sbin:/usr/sbin

# Install all busybox symlinks into /bin
/bin/busybox --install -s /bin 2>/dev/null || true

# Ensure all mount points and essential system directories exist
/bin/busybox mkdir -p /proc /sys /dev /sys/kernel/config /dev/infiniband /dev/shm /etc/libibverbs.d /mnt/weights /tmp /root /sbin 2>/dev/null || true

# 1. Mount essential kernel filesystems
/bin/mount -t proc none /proc 2>/dev/null || true
/bin/mount -t sysfs none /sys 2>/dev/null || true
/bin/mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
/bin/mount -t configfs none /sys/kernel/config 2>/dev/null || true

# 2. Extract VM parameters from /proc/cmdline
VM_ID=1
TOTAL_NODES=2
AUTORUN=""

if [ -f /proc/cmdline ]; then
    for arg in $(cat /proc/cmdline 2>/dev/null || /bin/busybox cat /proc/cmdline 2>/dev/null); do
        case "$arg" in
            vm_id=*) VM_ID="${arg#vm_id=}" ;;
            total_nodes=*) TOTAL_NODES="${arg#total_nodes=}" ;;
            autorun=*) AUTORUN="${arg#autorun=}" ;;
        esac
    done
fi

IP_ADDR="192.168.100.$((VM_ID + 1))"

echo "================================================="
echo "INITIALIZING RDMA VIRTUAL NODE $VM_ID OF $TOTAL_NODES"
echo "ASSIGNED IP: $IP_ADDR"
echo "================================================="

# 3. Bring up network interface
/bin/ip link set lo up 2>/dev/null || true
/bin/ip addr add ${IP_ADDR}/24 dev eth0 2>/dev/null || true
/bin/ip link set eth0 up 2>/dev/null || true
/bin/ip link set eth0 mtu 1500 2>/dev/null || true

# 4. Give the kernel a moment to initialize the link
/bin/sleep 1 2>/dev/null || true

# 5. Bind Soft-RoCE RDMA driver to eth0
/bin/rdma link add rxe0 type rxe netdev eth0 2>/dev/null || true
/bin/sleep 1 2>/dev/null || true

# 6. Build Infiniband device node
/bin/busybox mkdir -p /dev/infiniband 2>/dev/null || true
if [ -f /sys/class/infiniband_verbs/uverbs0/dev ]; then
    DEV_NUM=$(cat /sys/class/infiniband_verbs/uverbs0/dev 2>/dev/null || /bin/busybox cat /sys/class/infiniband_verbs/uverbs0/dev 2>/dev/null)
    MAJOR="${DEV_NUM%:*}"
    MINOR="${DEV_NUM#*:}"
    if [ -n "$MAJOR" ] && [ -n "$MINOR" ]; then
        /bin/busybox mknod /dev/infiniband/uverbs0 c "$MAJOR" "$MINOR" 2>/dev/null || true
    fi
    /bin/busybox chmod -R 777 /dev/infiniband 2>/dev/null || true
fi

# 7. Configure libibverbs driver
/bin/busybox mkdir -p /etc/libibverbs.d 2>/dev/null || true
echo "driver rxe" > /etc/libibverbs.d/rxe.driver 2>/dev/null || true

# 8. Mount 9p shared folder for model weights & python environment
/bin/busybox mkdir -p /mnt/weights 2>/dev/null || true
mount -t 9p -o trans=virtio,version=9p2000.L hostshare /mnt/weights 2>/dev/null || \
mount -t 9p -o trans=virtio,version=9p2000.L host_weights /mnt/weights 2>/dev/null || true

# 9. Mount RAM-disk for shared memory IPC
/bin/busybox mkdir -p /dev/shm 2>/dev/null || true
mount -t tmpfs -o size=2G tmpfs /dev/shm 2>/dev/null || true

# 10. Configure Environment Variables
export USER=root LOGNAME=root
export PATH=/mnt/weights/python_env/bin:/bin:/usr/bin:/sbin:$PATH
export LD_LIBRARY_PATH=/mnt/weights/python_env/lib:$LD_LIBRARY_PATH
export PYTHONPATH=/mnt/weights/python_env/lib/python3.12/site-packages
export PYTHONHOME=/mnt/weights/python_env
export TORCHINDUCTOR_CACHE_DIR=/tmp/torch_cache
export TRITON_CACHE_DIR=/tmp/triton_cache
export VM_ID="$VM_ID"
export TOTAL_NODES="$TOTAL_NODES"

echo "-------------------------------------------------"
echo "NODE READY: VM_ID=$VM_ID | IP=$IP_ADDR | RDMA=rxe0"
echo "-------------------------------------------------"

# 11. Launch background pipeline worker daemon if present in 9p share
if [ -f /mnt/weights/vm_worker.py ]; then
    echo "Starting VM Worker Service on port 18000..."
    python3 /mnt/weights/vm_worker.py --vm-id "$VM_ID" --port 18000 >/tmp/vm_worker.log 2>&1 &
fi

# 12. Execute autorun script if specified, otherwise interactive shell
if [ -n "$AUTORUN" ] && [ -f "$AUTORUN" ]; then
    echo "Executing autorun script: $AUTORUN"
    exec sh "$AUTORUN"
fi

exec /bin/sh

