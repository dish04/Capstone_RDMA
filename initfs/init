#!/bin/busybox sh

# 1. Mount essential filesystems
/bin/mount -t proc none /proc
/bin/mount -t sysfs none /sys
/bin/mount -t devtmpfs devtmpfs /dev
/bin/mount -t configfs none /sys/kernel/config

# 2. Extract VM parameters from /proc/cmdline
CMDLINE=$(cat /proc/cmdline)
VM_ID=$(echo "$CMDLINE" | grep -o 'vm_id=[0-9]*' | cut -d= -f2)
if [ -z "$VM_ID" ]; then
    VM_ID=1
fi

TOTAL_NODES=$(echo "$CMDLINE" | grep -o 'total_nodes=[0-9]*' | cut -d= -f2)
if [ -z "$TOTAL_NODES" ]; then
    TOTAL_NODES=2
fi

AUTORUN=$(echo "$CMDLINE" | grep -o 'autorun=[^ ]*' | cut -d= -f2)

IP_ADDR="192.168.100.$((VM_ID + 1))"

echo "================================================="
echo "INITIALIZING RDMA VIRTUAL NODE $VM_ID OF $TOTAL_NODES"
echo "ASSIGNED IP: $IP_ADDR"
echo "================================================="

# 3. Bring up network interface
/bin/ip link set lo up
/bin/ip addr add ${IP_ADDR}/24 dev eth0
/bin/ip link set eth0 up
/bin/ip link set eth0 mtu 1500

# 4. Give the kernel a moment to initialize the link
/bin/sleep 1

# 5. Bind Soft-RoCE RDMA driver to eth0
/bin/rdma link add rxe0 type rxe netdev eth0
/bin/sleep 1

# 6. Build Infiniband device node
mkdir -p /dev/infiniband
if [ -f /sys/class/infiniband_verbs/uverbs0/dev ]; then
    DEV_NUM=$(cat /sys/class/infiniband_verbs/uverbs0/dev)
    MAJOR=$(echo "$DEV_NUM" | cut -d: -f1)
    MINOR=$(echo "$DEV_NUM" | cut -d: -f2)
    mknod /dev/infiniband/uverbs0 c "$MAJOR" "$MINOR" 2>/dev/null || true
    chmod -R 777 /dev/infiniband
fi

# 7. Configure libibverbs driver
mkdir -p /etc/libibverbs.d
echo "driver rxe" > /etc/libibverbs.d/rxe.driver

# 8. Mount 9p shared folder for model weights & python environment
mkdir -p /mnt/weights
mount -t 9p -o trans=virtio,version=9p2000.L hostshare /mnt/weights 2>/dev/null || \
mount -t 9p -o trans=virtio,version=9p2000.L host_weights /mnt/weights 2>/dev/null || true

# 9. Mount RAM-disk for shared memory IPC
mkdir -p /dev/shm
mount -t tmpfs -o size=2G tmpfs /dev/shm 2>/dev/null || true

# 10. Configure Environment Variables
export USER=root LOGNAME=root
export PATH=/mnt/weights/python_env/bin:/bin:/usr/bin:$PATH
export LD_LIBRARY_PATH=/mnt/weights/python_env/lib:$LD_LIBRARY_PATH
export PYTHONPATH=/mnt/weights/python_env/lib/python3.12/site-packages
export PYTHONHOME=/mnt/weights/python_env
export TORCHINDUCTOR_CACHE_DIR=/tmp/torch_cache
export TRITON_CACHE_DIR=/tmp/triton_cache
export VM_ID="$VM_ID"
export TOTAL_NODES="$TOTAL_NODES"

echo "-------------------------------------------------"
echo "NODE READY: VM_ID=$VM_ID | IP=$IP_ADDR | RDMA=rxe0"
echo "-------------------------------------------------"

# 11. Execute autorun script if specified, otherwise interactive shell
if [ -n "$AUTORUN" ] && [ -f "$AUTORUN" ]; then
    echo "Executing autorun script: $AUTORUN"
    exec sh "$AUTORUN"
fi

exec /bin/sh

